# 运行模式：生产部署改为 production
NODE_ENV=development
# 网页与接口仅监听本机，由反向代理对外服务
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
API_PROXY_TARGET=http://127.0.0.1:3000
# 生产填写自己的网页域名，逗号分隔；不要使用通配符
CORS_ORIGINS=http://127.0.0.1:5173
# 只在有可信反向代理时配置，如 loopback
TRUST_PROXY=
RATE_LIMIT_ENABLED=false
# 本地数据库和样本目录；连接凭据在网页日志源配置里填写
DB_PATH=data/db/scum.db
RAW_DIR=data/raw/events
# 32 字节密钥：64 位十六进制或 Base64；留空自动生成 data/.datakey
# 必须连同数据库一起安全备份，不要提交密钥文件
DATA_KEY=
# 实时读取开关、毫秒间隔和在线推算超时秒数
INGEST_TAIL_ENABLED=true
INGEST_TAIL_INTERVAL_MS=2000
ONLINE_TIMEOUT_SEC=300
# 安全文件连接需要 Python 和 Paramiko；Linux 通常填 python3
PYTHON=python
SQL_LOG=false
# 独立监控口令可选；留空只允许已授权的登录账号
METRICS_TOKEN=
